{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Khởi chạy BeeCare Landing (npm run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Khởi chạy BeeCare & Mở Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "npm: dev"
    }
  ]
}
